# Copy to .env (never commit .env). Docker Compose reads it automatically.
PAIR=15
PORT_BASE=9150
SEED=15
DATABASE_PREFIX=p15
CITY_SET="Sunnyvale,Cupertino,Palo Alto"

# ---- Lab 2 services --------------------------------------------------------
# REQUIRED: a random secret of at least 32 characters, the same for every
# service. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

MONGO_DB=handshake_p15
# Inside Docker the services use mongodb://p15-mongo:27017 and p15-kafka:9092.
# Scripts run on your machine use these instead:
MONGO_URL=mongodb://127.0.0.1:27017
KAFKA_BOOTSTRAP=localhost:29092

# Ollama on the host (macOS: GPU via Metal). Inside Docker, the default
# http://host.docker.internal:11434 reaches it; scripts on the host use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192

# ---- Lab 1 MySQL (only to migrate real Lab 1 data) ---------------------------
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=handshake_pair15
MYSQL_USER=lab1_user
MYSQL_PASSWORD=change_me
DATABASE_URL=mysql+pymysql://lab1_user:change_me@127.0.0.1:3307/handshake_pair15
