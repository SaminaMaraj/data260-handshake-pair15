# p15-seed: one-off job that loads the Pair 15 dataset (random_state = 15) into
# MongoDB. Runs the Lab 1 seed generator into a temporary SQLite file, then
# migrates it. --if-empty makes it safe to run on every start.
#   docker build -f backend/scripts/Dockerfile.seed -t p15-seed:latest .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 SERVICE_NAME=p15-seed

WORKDIR /app
COPY backend/requirements/base.txt backend/requirements/seed.txt requirements/
RUN pip install -r requirements/seed.txt

COPY backend/app app
COPY backend/seed_generator.py seed_generator.py
COPY backend/scripts/__init__.py backend/scripts/migrate_to_mongo.py scripts/
COPY backend/services/__init__.py services/__init__.py
COPY backend/services/common services/common

RUN useradd --uid 10015 --create-home --shell /usr/sbin/nologin p15
USER p15

CMD ["python", "scripts/migrate_to_mongo.py", "--from-seed", "--if-empty"]
